[Unit]
Description=frpc tunnel for KSP PDF Signer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ksp
Group=ksp
ExecStart=/home/ksp/ksp-frpc/frpc -c /home/ksp/ksp-frpc/frpc.ini
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
