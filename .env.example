# ------------------------------------------------------------------
# ksp-pdfsign — cau hinh mau. Copy thanh `.env` va DOI cac mat khau.
# KHONG commit file .env that len git.
# ------------------------------------------------------------------

# --- Dang nhap trang web (PDF Signer) ---
APP_ADMIN_USERNAME=admin
# Bat buoc dat mat khau rieng, toi thieu 10 ky tu.
APP_ADMIN_PASSWORD=<DAT_MAT_KHAU_NGAU_NHIEN_MANH>

# Bi mat ky JWT (tao chuoi ngau nhien dai khi chay that)
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=480

# --- May Windows cam token (WIN-CA/WINCA/LCS-CA...) ---
AGENT_DEFAULT_IP=192.168.1.111
# Mat khau Administrator mac dinh cua may token
AGENT_ADMIN_PASSWORD=<DAT_MAT_KHAU_WINDOWS_THAT>

# --- Che do ky ---
# "ssh"  : backend SSH vao may Windows, ky bang kho chung thu Windows + CSP.
#          KHONG can cai gi tren may Windows ngoai OpenSSH Server. (khuyen nghi)
# "agent": goi HTTP toi Windows Agent da cai (windows-agent/agent.py).
SIGNING_MODE=ssh
SSH_USER=Administrator
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=60

# --- Windows Agent (chi dung khi SIGNING_MODE=agent) ---
AGENT_PORT=8443
AGENT_SCHEME=https
AGENT_VERIFY_TLS=false

# --- Ky so (tuy chon) ---
# URL dich vu timestamp RFC 3161 (de trong neu khong dung TSA)
TSA_URL=
# Bat nhung du lieu thu hoi de kiem tra lau dai (LTV)
ENABLE_LTV=false

# --- Kiem tra chu ky ---
# Co thu tai OCSP/CRL khi kiem tra khong (can Internet toi CA). Mac dinh false
# (soft-fail: van dung chuoi toi root CA, khong danh rot vi khong tai duoc CRL).
VERIFY_ALLOW_FETCHING=false

# --- Ky so / Chia se ---
# Noi ky mac dinh (sua duoc tren form ky)
DEFAULT_LOCATION=Đắk Lắk
# URL goc dung tao link chia se + so ngay het han mac dinh
PUBLIC_BASE_URL=https://ksp-pdf-signer.p2p.inut.io.vn
SHARE_DEFAULT_DAYS=7

# --- iNut Training (proxy noi bo; UI khong hien mat khau nay) ---
TRAINING_BASE_URL=http://host.docker.internal:8090
TRAINING_PASSWORD=
TRAINING_TIMEOUT=180
TRAINING_RATE_LIMIT_PER_MINUTE=100
TRAINING_RATE_WINDOW_SECONDS=60
TRAINING_SHARE_DAYS=30

# --- Facebook Messenger (Meta webhook) ---
# Page ID của iNut JSC; xác nhận lại trong Meta Business khi tạo token.
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=1698631723787176
FACEBOOK_PAGE_NAME=INUT JSC - IoT and Edge Computing
FACEBOOK_VERIFY_TOKEN=<TAO_TOKEN_WEBHOOK_RIENG>
FACEBOOK_APP_SECRET=<META_APP_SECRET>
FACEBOOK_PAGE_ACCESS_TOKEN=<META_PAGE_ACCESS_TOKEN>
FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_TIMEOUT=20
FACEBOOK_REPLY_ENABLED=true
# Legacy compatibility only; Messenger history is never sent to Hermes.
FACEBOOK_CONTEXT_TURNS=0
FACEBOOK_RETENTION_DAYS=365

# --- Telegram Bot (nhan thong bao Messenger) ---
# Tao bot moi trong @BotFather, thu hoi token cu neu da lo token.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Webinut_bot
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_CONNECT_TTL_SECONDS=600
TELEGRAM_NOTIFY_ENABLED=true

# --- Trợ lý công khai iNut.vn (BFF -> KSP bằng HMAC) ---
# Mặc định chỉ bind nội bộ; đặt secret riêng, dài >= 32 ký tự ở production.
PUBLIC_TRAINING_ENABLED=false
PUBLIC_TRAINING_HMAC_SECRET=<TAO_SECRET_SERVER_TO_SERVER_DAI>
PUBLIC_TRAINING_CLIENT_ID=inut-website
PUBLIC_TRAINING_RETENTION_DAYS=365
PUBLIC_TRAINING_RATE_LIMIT=100
PUBLIC_TRAINING_RATE_WINDOW_SECONDS=60

# --- BBBG: thong tin Ben A (ben ban giao) mac dinh (INUT) ---
BBBG_COMPANY=CÔNG TY CỔ PHẦN ĐẦU TƯ VÀ PHÁT TRIỂN CÔNG NGHỆ INUT
BBBG_ADDRESS=161 Trường Chinh, Phường Tuy Hòa, Tỉnh Đắk Lắk, Việt Nam
BBBG_MST=4401053694
BBBG_PHONE=0972768491
BBBG_REP=NGÔ HUỲNH NGỌC KHÁNH
BBBG_REP_TITLE=Giám đốc

# --- De nghi thanh toan: letterhead rieng (khac BBBG) ---
DNTT_NOI_LAP=TP.HCM
DNTT_EMAIL=khanhnhn@inut.vn
DNTT_WEBSITE=inut.vn
DNTT_REP=NGÔ HUỲNH NGỌC KHÁNH
DNTT_REP_TITLE=Tổng giám đốc

# --- Tai khoan nhan thanh toan (in tren bao gia/de nghi TT) ---
BANK_ACCOUNT_NAME=CÔNG TY CỔ PHẦN ĐẦU TƯ VÀ PHÁT TRIỂN CÔNG NGHỆ INUT
BANK_ACCOUNT_NUMBER=79713
BANK_NAME=Techcombank - Ngân hàng Thương mại Cổ phần Kỹ Thương Việt Nam

# --- AI thuyet minh bao gia (endpoint tuong thich OpenAI /chat/completions) ---
# 9router local (khuyen nghi, free): http://127.0.0.1:20128/v1 · model opencode/big-pickle
# Hoac OpenRouter: https://openrouter.ai/api/v1 + API key + model free bat ky.
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_MODEL=opencode/big-pickle
AI_API_KEY=public
# Model reasoning can max_tokens lon, neu nho content se rong
AI_MAX_TOKENS=3500

# --- Dong bo NAS (SMB) — backup ho so 1 chieu app -> NAS ---
NAS_ENABLED=true
NAS_HOST=172.32.0.100
NAS_SHARE=inut
NAS_USER=ksp
NAS_PASSWORD=Nhaphang123
NAS_BASE_PATH=ho-so
NAS_TIMEOUT=10

# --- ECUSSign Pro: snapshot PDF dinh kem sang Google Drive ---
# Chi doc database qua SCP; mac dinh tat de tranh upload ngoai y muon.
ECUS_DRIVE_SYNC_ENABLED=false
ECUS_SSH_HOST=192.168.1.111
ECUS_SSH_USER=Administrator
ECUS_SSH_KEY_PATH=/home/ksp/.ssh/id_ed25519
ECUS_DB_PATH=C:/pro/ECUSSIGN_PRO/Database/ECUSSIGN_DN_4401053694.DB
ECUS_SSH_TIMEOUT=60

# --- iHOADON (chi xem + tao hoa don GHI_TAM, khong ky/phat hanh) ---
IHOADON_ENABLED=false
IHOADON_BASE_URL=https://ihoadon.com.vn
IHOADON_TAX_CODE=4401053694
IHOADON_USERNAME=4401053694
# Dat trong Cài đặt tren web hoac khai bao tai day; KHONG commit mat khau that.
IHOADON_PASSWORD=
IHOADON_TIMEOUT=30

# --- TQC CNHQ lookup (exact public lookup + local model index) ---
TQC_CNHQ_BASE_URL=https://api-cnhq.tqc.gov.vn
# Optional key supplied by TQC for a documented collection/model-search route.
TQC_CNHQ_API_KEY=
TQC_CNHQ_TIMEOUT=15
TQC_CNHQ_CACHE_TTL_SECONDS=86400
TQC_CNHQ_RATE_LIMIT_PER_MINUTE=450

# --- Zoho Mail IMAP (dong bo hoa don PDF/XML tu email khanhnhn@inut.vn) ---
ZOHO_IMAP_ENABLED=true
ZOHO_IMAP_SERVER=imappro.zoho.com
ZOHO_IMAP_PORT=993
ZOHO_IMAP_USERNAME=khanhnhn@inut.vn
# Tao App Password trong Zoho Accounts (Security -> Application-Specific Passwords)
ZOHO_IMAP_PASSWORD=
ZOHO_IMAP_MAILBOX=INBOX
ZOHO_IMAP_DAYS=30

# --- Luu tru ---
DATA_DIR=./backend/data

# --- Local inut-crm MCP gateway ---
# Gateway binds to loopback only and proxies typed calls to the KSP backend.
KSP_BACKEND_URL=http://127.0.0.1:2032
MCP_BACKEND_USERNAME=
MCP_BACKEND_PASSWORD=
INUT_CRM_MCP_HOST=127.0.0.1
INUT_CRM_MCP_PORT=2037
INUT_CRM_MCP_TOKEN_FILE=/home/ksp/.config/inut-crm/inut-crm.token
INUT_CRM_MCP_AUDIT_PATH=./backend/data/mcp-audit.jsonl
